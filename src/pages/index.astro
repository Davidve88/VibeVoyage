---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VibeVoyage · Barcelona</title>
    <noscript><meta http-equiv="refresh" content={`0; url=${base}/en/`} /></noscript>
    <script is:inline define:vars={{ base }}>
      var l = (navigator.language || 'en').slice(0, 2);
      if (l !== 'de' && l !== 'es') l = 'en';
      location.replace(base + '/' + l + '/' + location.search);
    </script>
  </head>
  <body>
    <p><a href={`${base}/en/`}>English</a> · <a href={`${base}/de/`}>Deutsch</a> · <a href={`${base}/es/`}>Español</a></p>
  </body>
</html>
