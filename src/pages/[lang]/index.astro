---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PlaceList, { type PlaceData } from '../../components/PlaceList';
import TextSize from '../../components/TextSize';
import Welcome from '../../components/Welcome';
import { LANGS, type Lang } from '../../data/taxonomy';
import { ui, langNames } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entries = await getCollection('places');
const places: PlaceData[] = entries
  .map((e) => ({
    id: e.id,
    name: e.data.name,
    area: e.data.area,
    themes: e.data.themes,
    text: e.data.text[lang],
    tip: e.data.tip?.[lang],
    how: e.data.how?.[lang],
    links: e.data.links.map((l) => ({ type: l.type, url: l.url, label: l.label?.[lang] })),
    query: `${e.data.name} Barcelona`,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));

const listStrings = {
  area: t.area, theme: t.theme, clear: t.clear, one: t.one, many: t.many, none: t.none,
  map: t.map, tix: t.tix, web: t.web, how: t.how, photoBy: t.photoBy,
};
---

<Layout lang={lang}>
  <header class="top">
    <div>
      <h1>{t.title}</h1>
      <p class="sub">{t.tagline}</p>
    </div>
    <div class="ctrls">
      <nav class="seg" aria-label="Language">
        {LANGS.map((l) => (
          <a href={`${base}/${l}/`} class={l === lang ? 'on' : ''} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {langNames[l]}
          </a>
        ))}
      </nav>
      <TextSize client:load label={t.textSize} />
    </div>
  </header>
  <Welcome client:load h={t.welcomeH} b={t.welcomeB} noemiH={t.noemiH} noemiB={t.noemiB} sig={t.sig} ok={t.gotIt} />
  <PlaceList client:load lang={lang} places={places} t={listStrings} />
  <footer>{t.footer}</footer>
</Layout>
