---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import App from '../../components/App';
import type { PlaceData } from '../../components/PlaceList';
import TextSize from '../../components/TextSize';
import Welcome from '../../components/Welcome';
import { nearbyFor } from '../../lib/nearby';
import { COSTS, LANGS, type Lang } from '../../data/taxonomy';
import { ui, langNames } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entries = await getCollection('places');
const spots = entries.map((e) => ({ id: e.id, coords: e.data.coords, steep: e.data.steep, near: e.data.near }));
const nameOf = new Map(entries.map((e) => [e.id, e.data.name]));
const imgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/places/*.jpg', { eager: true });
const photoFor = async (file: string) => {
  const m = imgs[`../../assets/places/${file}`];
  return m ? (await getImage({ src: m.default, width: 800, format: 'webp' })).src : undefined;
};
const places: PlaceData[] = (await Promise.all(entries
  .map(async (e) => ({
    id: e.id,
    name: e.data.name,
    area: e.data.area,
    themes: e.data.themes,
    coords: e.data.coords,
    text: e.data.text[lang],
    tip: e.data.tip?.[lang],
    how: e.data.how?.[lang],
    good: e.data.good?.[lang],
    nearby: nearbyFor(spots.find((s) => s.id === e.id)!, spots).map((n) => ({ ...n, name: nameOf.get(n.id)! })),
    links: e.data.links.map((l) => ({ type: l.type, url: l.url, label: l.label?.[lang] })),
    cost: COSTS[e.data.cost][lang],
    time: e.data.time,
    query: `${e.data.name} Barcelona`,
    photo: e.data.photo
      ? { src: (await photoFor(e.data.photo.file))!, author: e.data.photo.author, license: e.data.photo.license, sourceUrl: e.data.photo.sourceUrl }
      : undefined,
  }))))
  .sort((a, b) => a.name.localeCompare(b.name, lang));

---

<Layout lang={lang}>
  <header class="top">
    <div>
      <h1>{t.title}</h1>
      <p class="sub">{t.tagline}</p>
    </div>
    <div class="ctrls">
      <nav class="seg" aria-label="Language">
        {LANGS.map((l) => (
          <a href={`${base}/${l}/`} class={l === lang ? 'on' : ''} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {langNames[l]}
          </a>
        ))}
      </nav>
      <TextSize client:load label={t.textSize} />
    </div>
  </header>
  <Welcome client:load h={t.welcomeH} b={t.welcomeB} noemiH={t.noemiH} noemiB={t.noemiB} sig={t.sig} ok={t.gotIt} close={t.close} />
  <App client:load lang={lang} places={places} t={t} />
  <footer>{t.footer}</footer>
  <script is:inline>
    // keep the current view (#map / #list) when switching language
    document.querySelectorAll('nav.seg a').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (location.hash) { e.preventDefault(); location.href = a.getAttribute('href') + location.hash; }
      });
    });
  </script>
</Layout>
